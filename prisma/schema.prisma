generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id Int @id @default(autoincrement())

  name      String
  shortName String
  logo      String @default("")

  city    String
  country String

  reputation Int @default(1)
  fans       Int @default(0)

  balance        Int @default(0)
  weeklyExpenses Int @default(0)
  weeklyIncome   Int @default(0)

  trainerLevel    Int @default(1)
  youthCoachLevel Int @default(1)

  players          Player[]
  academyPlayers   AcademyPlayer[]
  formation        Formation?
  trainingPlan     TrainingPlan?
  trainingSessions TrainingSession[]
  gameEvents       GameEvent[]

  transferListings TransferListing[] @relation("TransferListingSeller")
  transferBids     TransferBid[]     @relation("TransferBidder")
  wonListings      TransferListing[] @relation("TransferListingWinner")

  leagueEntries LeagueEntry[]

  homeFixtures LeagueFixture[] @relation("HomeClubFixtures")
  awayFixtures LeagueFixture[] @relation("AwayClubFixtures")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id Int @id @default(autoincrement())

  clubId Int?
  club   Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  nationality String
  age         Int

  form       Int   @default(5)
  morale     Int   @default(5)
  experience Float @default(0)

  talent    Float
  potential Float

  value  Int @default(0)
  salary Int @default(0)

  image String   @default("")
  style String[] @default([])

  precisione    Float
  diretto       Float
  sponde        Float
  tattica       Float
  mentalita     Float
  difesa        Float
  realizzazione Float
  creativita    Float
  misura        Float

  formationAsA Formation[] @relation("FormationSlotA")
  formationAsB Formation[] @relation("FormationSlotB")
  formationAsC Formation[] @relation("FormationSlotC")

  trainingResults TrainingResult[]

  transferListings TransferListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
}

model TransferListing {
  id Int @id @default(autoincrement())

  playerId Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  sellerClubId Int?
  sellerClub   Club? @relation("TransferListingSeller", fields: [sellerClubId], references: [id], onDelete: SetNull)

  winnerClubId Int?
  winnerClub   Club? @relation("TransferListingWinner", fields: [winnerClubId], references: [id], onDelete: SetNull)

  listingType String @default("AUCTION")
  status      String @default("ACTIVE")

  openingPrice Int

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  finalPrice  Int?
  completedAt DateTime?

  bids TransferBid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerClubId])
  @@index([winnerClubId])
  @@index([playerId])
  @@index([listingType])
  @@index([status])
  @@index([endsAt])
}

model TransferBid {
  id Int @id @default(autoincrement())

  listingId Int
  listing   TransferListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  bidderClubId Int
  bidderClub   Club @relation("TransferBidder", fields: [bidderClubId], references: [id], onDelete: Cascade)

  amount Int

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([bidderClubId])
  @@index([createdAt])
}

model AcademyPlayer {
  id Int @id @default(autoincrement())

  clubId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  nationality String
  age         Int

  talent    Float
  potential Float

  revealedAttributes    Int      @default(0)
  totalAttributes       Int      @default(9)
  revealedAttributeKeys String[] @default([])

  precisione    Float?
  diretto       Float?
  sponde        Float?
  tattica       Float?
  mentalita     Float?
  difesa        Float?
  realizzazione Float?
  creativita    Float?
  misura        Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
}

model Formation {
  id Int @id @default(autoincrement())

  clubId Int  @unique
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  slotAPlayerId Int?
  slotAPlayer   Player? @relation("FormationSlotA", fields: [slotAPlayerId], references: [id], onDelete: SetNull)

  slotBPlayerId Int?
  slotBPlayer   Player? @relation("FormationSlotB", fields: [slotBPlayerId], references: [id], onDelete: SetNull)

  slotCPlayerId Int?
  slotCPlayer   Player? @relation("FormationSlotC", fields: [slotCPlayerId], references: [id], onDelete: SetNull)

  savedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slotAPlayerId])
  @@index([slotBPlayerId])
  @@index([slotCPlayerId])
}

model TrainingPlan {
  id Int @id @default(autoincrement())

  clubId Int  @unique
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  primaryFocus   String @default("precisione")
  secondaryFocus String @default("tattica")

  savedAt         DateTime?
  lastProcessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingSession {
  id Int @id @default(autoincrement())

  clubId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  weekKey String

  primaryFocus   String
  secondaryFocus String

  trainerLevel      Int
  trainerEfficiency Int

  processedAt DateTime @default(now())

  results TrainingResult[]

  createdAt DateTime @default(now())

  @@unique([clubId, weekKey])
  @@index([clubId])
  @@index([processedAt])
}

model TrainingResult {
  id Int @id @default(autoincrement())

  sessionId Int
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  playerId Int?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  playerFirstName String
  playerLastName  String
  playerAge       Int

  usage     String
  intensity Int

  primaryBefore Float
  primaryGain   Float
  primaryAfter  Float

  secondaryBefore Float
  secondaryGain   Float
  secondaryAfter  Float

  overallBefore Float
  overallAfter  Float

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([playerId])
}

model GameEvent {
  id Int @id @default(autoincrement())

  clubId Int?
  club   Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String?

  createdAt DateTime @default(now())

  @@index([clubId])
  @@index([type])
  @@index([createdAt])
}

model Season {
  id Int @id @default(autoincrement())

  number Int    @unique
  name   String

  status String @default("PREPARATION")

  startsAt DateTime?
  endsAt   DateTime?

  leagues League[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model League {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  name      String
  level     Int    @default(1)
  groupCode String @default("A")

  status       String @default("PREPARATION")
  currentRound Int    @default(0)

  entries  LeagueEntry[]
  fixtures LeagueFixture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, level, groupCode])
  @@index([seasonId])
}

model LeagueEntry {
  id Int @id @default(autoincrement())

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  clubId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  played Int @default(0)

  won   Int @default(0)
  drawn Int @default(0)
  lost  Int @default(0)

  pointsFor     Int @default(0)
  pointsAgainst Int @default(0)
  points        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, clubId])
  @@index([leagueId])
  @@index([clubId])
}

model LeagueFixture {
  id Int @id @default(autoincrement())

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  round Int

  homeClubId Int
  homeClub   Club @relation("HomeClubFixtures", fields: [homeClubId], references: [id], onDelete: Cascade)

  awayClubId Int
  awayClub   Club @relation("AwayClubFixtures", fields: [awayClubId], references: [id], onDelete: Cascade)

  scheduledAt DateTime

  status String @default("SCHEDULED")

  homeScore Int?
  awayScore Int?

  playedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, round, homeClubId, awayClubId])
  @@index([leagueId])
  @@index([round])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([scheduledAt])
}
