generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id Int @id @default(autoincrement())

  name           String
  normalizedName String @unique
  shortName      String
  logo           String @default("")

  primaryColor   String @default("#065F46")
  secondaryColor String @default("#FBBF24")
  crestStyle     String @default("CLASSIC")

  city    String
  country String

  reputation Int @default(1)
  fans       Int @default(0)

  balance        Int @default(0)
  weeklyExpenses Int @default(0)
  weeklyIncome   Int @default(0)

  trainerLevel    Int @default(1)
  youthCoachLevel Int @default(1)

  academyInitialized     Boolean   @default(false)
  nextAcademyCandidateAt DateTime?
  nextWeeklyUpdateAt     DateTime?

  players           Player[]
  academyPlayers    AcademyPlayer[]
  formation         Formation?
  trainingPlan      TrainingPlan?
  trainingSessions  TrainingSession[]
  weeklyUpdates     ClubWeeklyUpdate[]
  gameEvents        GameEvent[]
  playerAppearances PlayerFixtureAppearance[]

  transferListings TransferListing[] @relation("TransferListingSeller")
  transferBids     TransferBid[]     @relation("TransferBidder")
  wonListings      TransferListing[] @relation("TransferListingWinner")

  manager Manager?

  leagueEntries LeagueEntry[]

  homeFixtures LeagueFixture[] @relation("HomeClubFixtures")
  awayFixtures LeagueFixture[] @relation("AwayClubFixtures")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Manager {
  id String @id @db.Uuid

  name           String
  normalizedName String @unique

  clubId Int?  @unique
  club   Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  onboardingStatus String @default("ACCOUNT_CREATED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id Int @id @default(autoincrement())

  clubId Int?
  club   Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  nationality String
  age         Int

  careerStatus       String    @default("ACTIVE")
  retiredAt          DateTime?
  retirementSeasonId Int?
  retirementSeason   Season?   @relation(fields: [retirementSeasonId], references: [id], onDelete: Restrict)

  form       Int   @default(5)
  morale     Int   @default(5)
  experience Float @default(0)

  talent Float

  value  Int @default(0)
  salary Int @default(0)

  image String   @default("")
  style String[] @default([])

  precisione    Float
  diretto       Float
  sponde        Float
  tattica       Float
  mentalita     Float
  difesa        Float
  realizzazione Float
  creativita    Float
  misura        Float

  formationAsA Formation[] @relation("FormationSlotA")
  formationAsB Formation[] @relation("FormationSlotB")
  formationAsC Formation[] @relation("FormationSlotC")

  trainingResults    TrainingResult[]
  fixtureAppearances PlayerFixtureAppearance[]

  transferListings TransferListing[]

  individualTournamentEntries  IndividualTournamentEntry[]
  individualMatchesAsPlayerOne IndividualTournamentMatch[] @relation("IndividualMatchPlayerOne")
  individualMatchesAsPlayerTwo IndividualTournamentMatch[] @relation("IndividualMatchPlayerTwo")
  individualMatchesWon         IndividualTournamentMatch[] @relation("IndividualMatchWinner")
  individualTournamentsWon     IndividualTournament[]      @relation("IndividualTournamentChampion")

  nationsCupEntriesAsFirst  NationsCupEntry[] @relation("NationsCupFirstPlayer")
  nationsCupEntriesAsSecond NationsCupEntry[] @relation("NationsCupSecondPlayer")
  nationsCupEntriesAsThird  NationsCupEntry[] @relation("NationsCupThirdPlayer")
  nationsCupTieBreaksAsHome NationsCupMatch[] @relation("NationsCupTieBreakHomePlayer")
  nationsCupTieBreaksAsAway NationsCupMatch[] @relation("NationsCupTieBreakAwayPlayer")
  nationsCupTieBreaksWon    NationsCupMatch[] @relation("NationsCupTieBreakWinnerPlayer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([careerStatus])
  @@index([retirementSeasonId])
}

model TransferListing {
  id Int @id @default(autoincrement())

  playerId Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  sellerClubId Int?
  sellerClub   Club? @relation("TransferListingSeller", fields: [sellerClubId], references: [id], onDelete: SetNull)

  winnerClubId Int?
  winnerClub   Club? @relation("TransferListingWinner", fields: [winnerClubId], references: [id], onDelete: SetNull)

  listingType String @default("AUCTION")
  status      String @default("ACTIVE")

  openingPrice Int

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  finalPrice  Int?
  completedAt DateTime?

  bids TransferBid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerClubId])
  @@index([winnerClubId])
  @@index([playerId])
  @@index([listingType])
  @@index([status])
  @@index([endsAt])
}

model TransferBid {
  id Int @id @default(autoincrement())

  listingId Int
  listing   TransferListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  bidderClubId Int
  bidderClub   Club @relation("TransferBidder", fields: [bidderClubId], references: [id], onDelete: Cascade)

  amount Int

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([bidderClubId])
  @@index([createdAt])
}

model AcademyPlayer {
  id Int @id @default(autoincrement())

  clubId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  nationality String
  age         Int

  talent Float

  revealedAttributes     Int       @default(0)
  totalAttributes        Int       @default(9)
  estimatedAttributeKeys String[]  @default([])
  revealedAttributeKeys  String[]  @default([])
  nextScoutingAt         DateTime?

  precisione    Float?
  diretto       Float?
  sponde        Float?
  tattica       Float?
  mentalita     Float?
  difesa        Float?
  realizzazione Float?
  creativita    Float?
  misura        Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
}

model Formation {
  id Int @id @default(autoincrement())

  clubId Int  @unique
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  slotAPlayerId Int?
  slotAPlayer   Player? @relation("FormationSlotA", fields: [slotAPlayerId], references: [id], onDelete: SetNull)

  slotBPlayerId Int?
  slotBPlayer   Player? @relation("FormationSlotB", fields: [slotBPlayerId], references: [id], onDelete: SetNull)

  slotCPlayerId Int?
  slotCPlayer   Player? @relation("FormationSlotC", fields: [slotCPlayerId], references: [id], onDelete: SetNull)

  savedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slotAPlayerId])
  @@index([slotBPlayerId])
  @@index([slotCPlayerId])
}

model TrainingPlan {
  id Int @id @default(autoincrement())

  clubId Int  @unique
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  primaryFocus   String @default("precisione")
  secondaryFocus String @default("tattica")

  savedAt         DateTime?
  lastProcessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingSession {
  id Int @id @default(autoincrement())

  clubId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  weekKey String

  primaryFocus   String
  secondaryFocus String

  trainerLevel      Int
  trainerEfficiency Int

  processedAt DateTime @default(now())

  results TrainingResult[]

  createdAt DateTime @default(now())

  @@unique([clubId, weekKey])
  @@index([clubId])
  @@index([processedAt])
}

model TrainingResult {
  id Int @id @default(autoincrement())

  sessionId Int
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  playerId Int?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  playerFirstName String
  playerLastName  String
  playerAge       Int

  usage     String
  intensity Int

  primaryBefore  Float
  primaryGain    Float
  primaryDecline Float @default(0)
  primaryAfter   Float

  secondaryBefore  Float
  secondaryGain    Float
  secondaryDecline Float @default(0)
  secondaryAfter   Float

  overallBefore  Float
  overallDecline Float @default(0)
  overallAfter   Float

  experienceBefore Float @default(0)
  experienceGain   Float @default(0)
  experienceAfter  Float @default(0)

  formBefore Int @default(5)
  formChange Int @default(0)
  formAfter  Int @default(5)

  moraleBefore Int @default(5)
  moraleChange Int @default(0)
  moraleAfter  Int @default(5)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([playerId])
}

model ClubWeeklyUpdate {
  id Int @id @default(autoincrement())

  clubId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  weekKey String

  income        Int
  expenses      Int
  netResult     Int
  balanceBefore Int
  balanceAfter  Int

  scheduledAt     DateTime
  processedAt     DateTime
  newsScheduledAt DateTime
  newsPublishedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([clubId, weekKey])
  @@index([clubId])
  @@index([scheduledAt])
  @@index([newsScheduledAt])
}

model GameEvent {
  id Int @id @default(autoincrement())

  clubId Int?
  club   Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String?

  createdAt DateTime @default(now())

  @@index([clubId])
  @@index([type])
  @@index([createdAt])
}

model Season {
  id Int @id @default(autoincrement())

  number Int    @unique
  name   String

  status String @default("PREPARATION")

  startsAt DateTime?
  endsAt   DateTime?

  leagues               League[]
  retiredPlayers        Player[]
  individualTournaments IndividualTournament[]
  nationsCup            NationsCupTournament?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NationsCupTournament {
  id Int @id @default(autoincrement())

  seasonId Int    @unique
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  leagueRound  Int      @default(7)
  name         String   @default("Coppa delle Nazioni")
  status       String   @default("SCHEDULED")
  currentStage String?
  drawAt       DateTime
  finalAt      DateTime
  championCode String?

  entries NationsCupEntry[]
  matches NationsCupMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([drawAt])
  @@index([finalAt])
}

model NationsCupEntry {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament   NationsCupTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  nationCode   String
  nationName   String
  nationFlag   String
  seed         Int
  groupCode    String
  rankingTotal Int

  firstPlayerId  Int
  firstPlayer    Player @relation("NationsCupFirstPlayer", fields: [firstPlayerId], references: [id], onDelete: Restrict)
  secondPlayerId Int
  secondPlayer   Player @relation("NationsCupSecondPlayer", fields: [secondPlayerId], references: [id], onDelete: Restrict)
  thirdPlayerId  Int
  thirdPlayer    Player @relation("NationsCupThirdPlayer", fields: [thirdPlayerId], references: [id], onDelete: Restrict)

  played          Int     @default(0)
  won             Int     @default(0)
  drawn           Int     @default(0)
  lost            Int     @default(0)
  pointsFor       Int     @default(0)
  pointsAgainst   Int     @default(0)
  points          Int     @default(0)
  eliminatedStage String?

  homeMatches NationsCupMatch[] @relation("NationsCupHomeEntry")
  awayMatches NationsCupMatch[] @relation("NationsCupAwayEntry")
  matchesWon  NationsCupMatch[] @relation("NationsCupWinnerEntry")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, nationCode])
  @@unique([tournamentId, seed])
  @@index([tournamentId, groupCode])
}

model NationsCupMatch {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament   NationsCupTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  stage       String
  stageOrder  Int
  groupCode   String?
  position    Int
  scheduledAt DateTime

  homeEntryId   Int
  homeEntry     NationsCupEntry  @relation("NationsCupHomeEntry", fields: [homeEntryId], references: [id], onDelete: Cascade)
  awayEntryId   Int
  awayEntry     NationsCupEntry  @relation("NationsCupAwayEntry", fields: [awayEntryId], references: [id], onDelete: Cascade)
  winnerEntryId Int?
  winnerEntry   NationsCupEntry? @relation("NationsCupWinnerEntry", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  homeScore              Int?
  awayScore              Int?
  tieBreakSpecialty      String?
  tieBreakHomePlayerId   Int?
  tieBreakHomePlayer     Player? @relation("NationsCupTieBreakHomePlayer", fields: [tieBreakHomePlayerId], references: [id], onDelete: SetNull)
  tieBreakAwayPlayerId   Int?
  tieBreakAwayPlayer     Player? @relation("NationsCupTieBreakAwayPlayer", fields: [tieBreakAwayPlayerId], references: [id], onDelete: SetNull)
  tieBreakWinnerPlayerId Int?
  tieBreakWinnerPlayer   Player? @relation("NationsCupTieBreakWinnerPlayer", fields: [tieBreakWinnerPlayerId], references: [id], onDelete: SetNull)
  games                  Json?

  status    String    @default("SCHEDULED")
  playedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tournamentId, stageOrder, position])
  @@index([tournamentId])
  @@index([stageOrder])
  @@index([scheduledAt])
  @@index([status])
}

model IndividualTournament {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  leagueRound Int
  type        String
  name        String
  specialty   String

  status       String  @default("SCHEDULED")
  currentStage String?

  drawAt  DateTime
  finalAt DateTime

  championPlayerId Int?
  championPlayer   Player? @relation("IndividualTournamentChampion", fields: [championPlayerId], references: [id], onDelete: SetNull)

  entries IndividualTournamentEntry[]
  matches IndividualTournamentMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, leagueRound])
  @@index([seasonId])
  @@index([status])
  @@index([drawAt])
  @@index([finalAt])
  @@index([championPlayerId])
}

model IndividualTournamentEntry {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament   IndividualTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  playerId Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  rankingAtDraw Int
  overallAtDraw Float
  drawPosition  Int

  status          String  @default("ACTIVE")
  eliminatedStage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, playerId])
  @@unique([tournamentId, drawPosition])
  @@index([tournamentId])
  @@index([playerId])
  @@index([status])
}

model IndividualTournamentMatch {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament   IndividualTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  stage       String
  stageOrder  Int
  position    Int
  scheduledAt DateTime

  playerOneId Int?
  playerOne   Player? @relation("IndividualMatchPlayerOne", fields: [playerOneId], references: [id], onDelete: SetNull)

  playerTwoId Int?
  playerTwo   Player? @relation("IndividualMatchPlayerTwo", fields: [playerTwoId], references: [id], onDelete: SetNull)

  winnerPlayerId Int?
  winnerPlayer   Player? @relation("IndividualMatchWinner", fields: [winnerPlayerId], references: [id], onDelete: SetNull)

  playerOneWins Int @default(0)
  playerTwoWins Int @default(0)

  status   String    @default("SCHEDULED")
  playedAt DateTime?

  games IndividualTournamentGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, stageOrder, position])
  @@index([tournamentId])
  @@index([stageOrder])
  @@index([scheduledAt])
  @@index([status])
  @@index([playerOneId])
  @@index([playerTwoId])
  @@index([winnerPlayerId])
}

model IndividualTournamentGame {
  id Int @id @default(autoincrement())

  matchId Int
  match   IndividualTournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  order      Int
  specialty  String
  winnerSide String

  playerOnePerformanceRating Float
  playerTwoPerformanceRating Float

  playerOneScore Int
  playerTwoScore Int

  reconstructed Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([matchId, order])
  @@index([matchId])
  @@index([specialty])
}

model League {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  name      String
  level     Int    @default(1)
  groupCode String @default("A")

  status       String @default("PREPARATION")
  currentRound Int    @default(0)

  entries  LeagueEntry[]
  fixtures LeagueFixture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, level, groupCode])
  @@index([seasonId])
}

model LeagueEntry {
  id Int @id @default(autoincrement())

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  clubId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  played Int @default(0)

  won   Int @default(0)
  drawn Int @default(0)
  lost  Int @default(0)

  pointsFor     Int @default(0)
  pointsAgainst Int @default(0)
  points        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, clubId])
  @@index([leagueId])
  @@index([clubId])
}

model LeagueFixture {
  id Int @id @default(autoincrement())

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  round Int

  homeClubId Int
  homeClub   Club @relation("HomeClubFixtures", fields: [homeClubId], references: [id], onDelete: Cascade)

  awayClubId Int
  awayClub   Club @relation("AwayClubFixtures", fields: [awayClubId], references: [id], onDelete: Cascade)

  scheduledAt DateTime

  status String @default("SCHEDULED")

  homeScore Int?
  awayScore Int?

  playedAt DateTime?

  games             LeagueFixtureGame[]
  playerAppearances PlayerFixtureAppearance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, round, homeClubId, awayClubId])
  @@index([leagueId])
  @@index([round])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([scheduledAt])
}

model LeagueFixtureGame {
  id Int @id @default(autoincrement())

  fixtureId Int
  fixture   LeagueFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  order        Int
  specialty    String
  gameType     String
  targetPoints Int

  winnerSide String

  homePoints Int
  awayPoints Int

  reconstructed Boolean @default(false)

  homePerformanceRating Float
  awayPerformanceRating Float

  homeWinProbability Float
  awayWinProbability Float
  randomValue        Float

  playerPerformances PlayerGamePerformance[]

  createdAt DateTime @default(now())

  @@unique([fixtureId, order])
  @@index([fixtureId])
  @@index([specialty])
}

model PlayerFixtureAppearance {
  id Int @id @default(autoincrement())

  fixtureId Int
  fixture   LeagueFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  playerId Int?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  clubId Int?
  club   Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  playerFirstName   String
  playerLastName    String
  playerNationality String
  playerAge         Int

  clubName         String
  opponentClubName String

  side          String
  formationSlot String

  teamScore     Int
  opponentScore Int

  overall           Float
  form              Int
  morale            Int
  experience        Float
  performanceRating Float

  playedAt DateTime

  gamePerformances PlayerGamePerformance[]

  createdAt DateTime @default(now())

  @@unique([fixtureId, side, formationSlot])
  @@index([fixtureId])
  @@index([playerId])
  @@index([clubId])
  @@index([playedAt])
}

model PlayerGamePerformance {
  id Int @id @default(autoincrement())

  fixtureGameId Int
  fixtureGame   LeagueFixtureGame @relation(fields: [fixtureGameId], references: [id], onDelete: Cascade)

  appearanceId Int
  appearance   PlayerFixtureAppearance @relation(fields: [appearanceId], references: [id], onDelete: Cascade)

  result String

  specialtyRating   Float
  performanceRating Float

  formModifier       Float
  moraleModifier     Float
  experienceModifier Float

  createdAt DateTime @default(now())

  @@unique([fixtureGameId, appearanceId])
  @@index([fixtureGameId])
  @@index([appearanceId])
  @@index([result])
}
